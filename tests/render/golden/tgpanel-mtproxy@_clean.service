# Managed by tgpanel. Do not edit: regenerated on every apply.
[Unit]
Description=Telegram MTProxy pool %i (tgpanel)
After=network-online.target tgpanel-firewall.service
Wants=network-online.target
Requires=tgpanel-firewall.service

[Service]
Type=simple
User=mtproxy
Group=mtproxy
WorkingDirectory=/var/lib/mtproxy
EnvironmentFile=/etc/tgpanel/mtproxy/%i.env
ExecStart=/opt/MTProxy/objs/bin/mtproto-proxy -u mtproxy -p ${MTP_STATS_PORT} -H ${MTP_PORT} $MTP_SECRET_ARGS $MTP_NAT_ARGS --aes-pwd /etc/mtproxy/proxy-secret /etc/mtproxy/proxy-multi.conf -M ${MTP_WORKERS} -C ${MTP_MAX_CONNECTIONS}
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/etc/mtproxy /etc/tgpanel/mtproxy
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
CapabilityBoundingSet=
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
